# Aurora Intents API key — https://studio.aurora.dev/
INTENTS_API_KEY=

# ENS network for resolution / minting
ENS_CHAIN=sepolia
# ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Parent ENS namespace (invoices are inv-{id}.ENS_PARENT_NAME)
ENS_PARENT_NAME=commons3nse.eth

# Private key of the parent ENS owner. NEVER commit this value.
ENS_CONTROLLER_PRIVATE_KEY=

ENS_ONCHAIN_MINT=true

DESTINATION_ASSET_SYMBOL=USDC
DESTINATION_CHAIN=sol
DEFAULT_SLIPPAGE_BPS=100
QUOTE_DEADLINE_MINUTES=15
INTENTS_CONNECT_API_URL=https://intents-connect-api.aurora.dev

# Public app URL used in invoice PDFs / share links
NEXT_PUBLIC_APP_URL=http://localhost:3001

# EthSwarm (sponsored postage — Enscribe Bee holds xBZZ, users do not)
# Docs: https://docs.ethswarm.org/docs/develop/upload-and-download/
# BEE_BATCH_ID is SERVER-ONLY — never expose via NEXT_PUBLIC_* or client bundles.
BEE_URL=https://api.gateway.ethswarm.org
BEE_BATCH_ID=
# Optional Bee API password if the node requires auth
# BEE_API_PASSWORD=
# Encrypt invoice PDFs with Bee client encryption (embeds key in ref; kept server-side)
SWARM_ENCRYPT=true
# AES key material for per-wallet user records (profile + invoice ledger on Swarm feeds)
SWARM_DATA_SECRET=
# Optional feed signer (defaults to ENS_CONTROLLER_PRIVATE_KEY)
# SWARM_FEED_PRIVATE_KEY=
# Optional: buy a fresh batch when BEE_BATCH_ID is empty (needs funded Bee wallet)
# SWARM_BUY_STORAGE=false
# SWARM_STORAGE_GB=0.1
# SWARM_STORAGE_DAYS=365
